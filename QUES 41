#include <stdio.h>

int main() {
    int n, temp, first, last, place = 1, result;

    scanf("%d", &n);

    if (n < 0) {
        printf("Invalid input");
        return 0;
    }

    temp = n;
    last = n % 10;

    while (temp >= 10) {
        temp /= 10;
        place *= 10;
    }

    first = temp;
    result = last * place + (n % place - last) + first;

    printf("%d", result);

    return 0;
}
