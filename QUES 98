
#include <stdio.h>

int main()
{
    char name[100];
    int i, last = 0;

    printf("Enter your full name: ");
    scanf(" %[^\n]", name);

    for(i = 0; name[i] != '\0'; i++)
    {
        if(name[i] == ' ' && name[i + 1] != ' ')
        {
            last = i + 1;
        }
    }

    printf("Formatted name: ");

    for(i = 0; i < last; i++)
    {
        if(i == 0 || (name[i - 1] == ' ' && name[i] != ' '))
        {
            printf("%c. ", name[i]);
        }
    }

    for(i = last; name[i] != '\0'; i++)
    {
        printf("%c", name[i]);
    }

    return 0;
}
