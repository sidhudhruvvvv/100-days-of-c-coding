
#include <stdio.h>

int main()
{
    char str[100];
    int i, j, k;
    int count, max = 0, repeated;

    printf("Enter a string: ");
    scanf("%s", str);

    for(i = 0; str[i] != '\0'; i++)
    {
        count = 0;

        for(j = i; str[j] != '\0'; j++)
        {
            repeated = 0;

            for(k = i; k < j; k++)
            {
                if(str[k] == str[j])
                {
                    repeated = 1;
                    break;
                }
            }

            if(repeated == 1)
                break;

            count++;
        }

        if(count > max)
        {
            max = count;
        }
    }

    printf("Longest substring length = %d", max);

    return 0;
}
