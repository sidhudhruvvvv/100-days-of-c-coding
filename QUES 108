
#include <stdio.h>

int main()
{
    int a[100], result[100];
    int n, i, j, product;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    for(i = 0; i < n; i++)
    {
        product = 1;

        for(j = 0; j < n; j++)
        {
            if(i != j)
            {
                product = product * a[j];
            }
        }

        result[i] = product;
    }

    printf("Result array: ");

    for(i = 0; i < n; i++)
    {
        printf("%d ", result[i]);
    }

    return 0;
}

