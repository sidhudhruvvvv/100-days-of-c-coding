
#include <stdio.h>

int main()
{
    int dd, mm, yyyy;

    printf("Enter date (dd/mm/yyyy): ");
    scanf("%d/%d/%d", &dd, &mm, &yyyy);

    if(mm == 4)
    {
        printf("Formatted date: %02d-Apr-%04d",
               dd, yyyy);
    }
    else
    {
        printf("Month should be 04");
    }

    return 0;
}
