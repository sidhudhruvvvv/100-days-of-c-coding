
#include <stdio.h>

int main()
{
    int a[100], n, k, i, j;
    int max;

    printf("Enter size of array: ");
    scanf("%d", &n);

    printf("Enter array elements: ");
    for(i = 0; i < n; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter value of k: ");
    scanf("%d", &k);

    if(k < 1 || k > n)
    {
        printf("Invalid value of k");
        return 0;
    }

    printf("Maximum elements: ");

    for(i = 0; i <= n - k; i++)
    {
        max = a[i];

        for(j = i + 1; j < i + k; j++)
        {
            if(a[j] > max)
            {
                max = a[j];
            }
        }

        printf("%d ", max);
    }

    return 0;
}
