
#include <stdio.h>

int main()
{
    int n, x, i;
    int left, right, found = 0;

    printf("Enter a positive integer: ");
    scanf("%d", &n);

    for(x = 1; x <= n; x++)
    {
        left = 0;
        right = 0;

        for(i = 1; i <= x; i++)
        {
            left = left + i;
        }

        for(i = x; i <= n; i++)
        {
            right = right + i;
        }

        if(left == right)
        {
            printf("Pivot integer = %d", x);
            found = 1;
            break;
        }
    }

    if(found == 0)
    {
        printf("-1");
    }

    return 0;
}
